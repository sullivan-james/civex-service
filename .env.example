# Copy to .env and fill in as needed. civex does not auto-load .env; export these
# into your shell (e.g. `set -a; source .env; set +a`) or use direnv.

# Anthropic API key used by AI-powered plugins/tools (falls back to config.toml [ai].api_key).
ANTHROPIC_API_KEY=

# Sentry DSN for error telemetry (falls back to config.toml [telemetry].dsn). Leave unset to disable.
CIVEX_SENTRY_DSN=

# SQLAlchemy database URL, e.g. sqlite:///./civex.db or postgresql://user:pass@host/db
# (falls back to config.toml [db].url).
CIVEX_DB_URL=

# Log level for the server/CLI: DEBUG | INFO | WARNING | ERROR (default: INFO).
CIVEX_LOG_LEVEL=

# Force JSON console logging instead of pretty output when set to 1 (default: auto — pretty on a TTY).
CIVEX_LOG_JSON=

# Set to 1 to allow the server to accept non-loopback connections. Off by default for safety.
CIVEX_ALLOW_REMOTE=
